# API Keys (no subir claves reales a Git)
# GEMINI_API_KEY se incrusta en el build de Vite -> debe estar definida al compilar.
GEMINI_API_KEY=tu_clave_gemini

# --- Proveedores de datos de fútbol (cascada: api-football -> football-data -> ESPN) ---
# Principal (100 req/día gratis). Opcional: sin ella se usan las gratuitas.
FOOTBALL_API_KEY=
# Gratis para siempre (12 competiciones top). Regístrate en https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# Legado/opcional: el plan gratis de Sportmonks solo cubre 2 ligas menores.
SPORTMONKS_API_TOKEN=

# --- Extras ---
# Cuotas (500 req/mes gratis): https://the-odds-api.com
ODDS_API_KEY=
# Telegram (envío desde Mis Picks): crea el bot con @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
